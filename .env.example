# Supabase project credentials
# Find these in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Site URL (used for metadata / canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (optional).
# Leave empty to load no analytics at all.
NEXT_PUBLIC_GA_ID=

# Social profile links shown in the footer + structured data.
# Keep these in sync with SOCIAL_LINKS in lib/site.ts.
# (Edit lib/site.ts to add them.)

# ─────────────────────────────────────────────────────────────────────────────
# ImageKit — Media CDN (DB #3) for gallery images, videos, magazines
# ─────────────────────────────────────────────────────────────────────────────
# Get these from: https://imagekit.io/dashboard -> Developer Options -> API keys
#
# IMAGEKIT_PUBLIC_KEY   — used for signed URL generation (server-side)
# IMAGEKIT_PRIVATE_KEY  — NEVER expose to the browser; server-only
# IMAGEKIT_URL_ENDPOINT — your unique ImageKit CDN base URL
#
# NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT — same endpoint, exposed to the browser
#   for client-side URL building (no secret). Safe to expose publicly.

IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID
