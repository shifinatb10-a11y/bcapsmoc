# Supabase project credentials
# Find these in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Site URL (used for metadata / canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (optional).
# Leave empty to load no analytics at all.
NEXT_PUBLIC_GA_ID=

# Social profile links shown in the footer + structured data.
# Keep these in sync with SOCIAL_LINKS in lib/site.ts.
# (Edit lib/site.ts to add them.)
